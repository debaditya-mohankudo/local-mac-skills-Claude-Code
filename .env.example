# Copy to .env and fill in. .env is gitignored — keep real values out of git.

# Obsidian vault
VAULT_NAME=my_vault
VAULT_PATH=/Users/<you>/path/to/my_vault

# Apple Mail accounts — comma-separated key:uuid:address triples.
# The UUID is Mail.app's own account identifier, stable across renames; find it
# under Settings -> Accounts, or in ~/Library/Mail/V*/MailData.
MAIL_ACCOUNTS=gmail:00000000-0000-0000-0000-000000000000:you@example.com

# Optional. Defaults to the first key in MAIL_ACCOUNTS.
MAIL_DEFAULT_ACCOUNT=gmail

# Optional. "On My Mac" local mailboxes, comma-separated.
MAIL_LOCAL_MAILBOXES=

# Phone number used by the iMessage tools, in the format Messages expects.
PHONE_NUMBER=+10000000000
